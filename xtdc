xtdc_ren_ext(){
        dica="- Renomeia arquivos com ext.EXT"    
dir="${1:-.}"
cd "$dir" || exit 1

for arquivo in *; do
    # Pula diretórios e o próprio script
    [ -f "$arquivo" ] || continue
    [ "$arquivo" = "renomear-ext.sh" ] && continue

    # Extrai a extensão (tudo após o último ponto)
    base="${arquivo%.*}"
    ext="${arquivo##*.}"

    # Sem extensão (ex: "Makefile") → pula
    [ "$base" = "$arquivo" ] && continue

    # Nome alvo: ext.ext
    alvo="${ext}.${ext}"

    # Já tem o nome certo → pula
    [ "$arquivo" = "$alvo" ] && continue

    if [ -e "$alvo" ]; then
        echo "⚠  '$alvo' já existe → apagando '$arquivo'"
        rm -- "$arquivo"
    else
        mv -- "$arquivo" "$alvo"
        echo "✓  '$arquivo' → '$alvo'"
    fi
done

    }

xtdc_funcoes(){
    awk '
        function exibir(){
            if (nome != "" && nome != "xtdc_funcoes") {
                printf "\033[1;97m%s\033[0m \033[96m%s\033[0m\n", nome, dica
            }
        }

        /^[[:space:]]*(function[[:space:]]+)?xtdc_[[:alnum:]_]+[[:space:]]*(\(\))?[[:space:]]*\{/ {
            exibir()
            linha = $0
            sub(/^[[:space:]]*function[[:space:]]+/, "", linha)
            sub(/^[[:space:]]*/, "", linha)
            sub(/[[:space:]]*(\(\))?[[:space:]]*\{.*/, "", linha)
            nome = linha
            dica = ""
            next
        }

        nome != "" && /^[[:space:]]*dica[[:space:]]*=/ {
            dica = $0
            sub(/^[^=]*=[[:space:]]*/, "", dica)
            sub(/^["'\'']/, "", dica)
            sub(/["'\''][[:space:]]*;?[[:space:]]*$/, "", dica)
        }

        END { exibir() }
    ' "${BASH_SOURCE[0]}"
}

