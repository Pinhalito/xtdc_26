xtdc_esconde_link(){
    dica="- Esconde links simbólicos"
    find . -type l -exec sh -c '
for link do
    dir=$(dirname "$link")
    nome=$(basename "$link")
    printf "%s\n" "$nome" >> "$dir/.hidden"
    sort -u "$dir/.hidden" -o "$dir/.hidden"
done
' sh {} +
}

