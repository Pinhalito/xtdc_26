xtdc_dormir(){
    dica="- Suspende o sistema por um tempo"    
set -e

printf "Suspender por quantos minutos? "
read -r MIN

# Valida se foi digitado um número inteiro maior que zero
if ! [[ "$MIN" =~ ^[0-9]+$ ]] || [ "$MIN" -le 0 ]; then
    echo "Por favor, digite um número válido de minutos (ex: 30)."
    exit 1
fi

# Converte minutos para segundos e calcula a hora prevista de retorno
SEC=$((MIN * 60))
WAKEUP_TIME=$(date -d "+${SEC} seconds" "+%H:%M:%S")

echo "Iniciando suspensão: $(date '+%H:%M:%S') — retorno previsto às $WAKEUP_TIME ($MIN min)..."
sudo rtcwake -m mem -s "$SEC"

echo "Sistema retomado: $(date '+%H:%M:%S')"
}

