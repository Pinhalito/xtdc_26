xtdc_loga(){
    dica="- Escreve um log"
    local msg="${1:-}"
    local log_file="$PWD/$(date +'%Y_%m_%d')_log.txt"
    echo "$msg" >> "$log_file"
}

xtdc_funcoes(){
    awk '
        function exibir(){
            if (nome != "" && nome != "xtdc_funcoes") {
                printf "\033[1;97m%s\033[0m \033[96m%s\033[0m\n", nome, dica
            }
        }

        /^[[:space:]]*(function[[:space:]]+)?xtdc_[[:alnum:]_]+[[:space:]]*(\(\))?[[:space:]]*\{/ {
            exibir()
            linha = $0
            sub(/^[[:space:]]*function[[:space:]]+/, "", linha)
            sub(/^[[:space:]]*/, "", linha)
            sub(/[[:space:]]*(\(\))?[[:space:]]*\{.*/, "", linha)
            nome = linha
            dica = ""
            next
        }

        nome != "" && /^[[:space:]]*dica[[:space:]]*=/ {
            dica = $0
            sub(/^[^=]*=[[:space:]]*/, "", dica)
            sub(/^["'\'']/, "", dica)
            sub(/["'\''][[:space:]]*;?[[:space:]]*$/, "", dica)
        }

        END { exibir() }
    ' "${BASH_SOURCE[0]}"
}



