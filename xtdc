}

xtdc_terminalnotopo(){
    dica="- Terminal no topo"
    xfce4-terminal &
    for i in $(seq 1 100); do
        ID=$(wmctrl -lx | awk 'tolower($3) ~ /xfce4-terminal\.xfce4-terminal/ {print $1; exit}')
        if [ -n "$ID" ]; then
            wmctrl -i -r "$ID" -b add,above
            return $?
        fi
        sleep 0.1
    done
    return 1
}

