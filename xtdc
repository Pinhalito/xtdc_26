xtdc_carga(){
    dica="- Carrega as funções XTDC"
    if [ -f /bin/xtdc ]; then
    source /bin/xtdc
    notify-send -t 3000 -i dialog-information "XTDC" "Funções carregadas em: $(date +%H:%M:%S)"
    fi
}

xtdc_limpa(){
     dica="- Limpa o sistema usando o Bleachbit"
     bleachbit -c --preset
     sudo bleachbit -c --preset
     notify-send -t 3000 -i dialog-information "Sistema limpo" "Limpo em: $(date +%H:%M:%S)"
}

xtdc_apt(){
    dica="- Limpa o apt"
    sudo apt update
    sudo apt autoremove -y --purge
    sudo apt autoremove -y
    sudo apt autoclean
    sudo apt clean
}

xtdc_som(){
    dica="- Restaura o som"
    sudo rmmod -f snd-hda_intel
    sudo modprobe snd-hda_intel
}

xtdc_il(){
    dica="- Instala pkg sem recomendados direto"
    sudo apt update
    local pkgil="${1:-}"
    sudo apt install -y --no-install-recommends "$pkgil"
    sudo apt clean
    sudo apt autoclean
    sudo apt autoremove --purge
}

xtdc_pkg(){
    dica="- Lista os pacotes instalados"
dpkg-query -W -f='${binary:Package}\n'
}

xtdc_ver(){
    dica="- Lista os pacotes instalados e versões"
dpkg-query -W -f='${binary:Package}\t${Version}\n'
}

xtdc_printa(){
destino="$HOME/Imagens"
#mkdir -p "$destino" || exit 1
arquivo="$destino/print_$(date +%Y_%m_%d_%H_%M_%S).png"

# Selecione a região com o mouse; cancelar encerra o script.
xfce4-screenshooter --region --save "$arquivo" || exit 1

# Copia o PNG salvo para o clipboard.
xclip -selection clipboard -t image/png -i "$arquivo"

notify-send -t 3000 -i camera-photo "Captura de Tela" "Salva em:\n${arquivo}"
}
    
xtdc_esconde_link(){
    dica="- Esconde links simbólicos"
    find . -type l -exec sh -c '
for link do
    dir=$(dirname "$link")
    nome=$(basename "$link")
    printf "%s\n" "$nome" >> "$dir/.hidden"
done
' sh {} +
}

